# The browser uses same-origin /api by default. Use a Vite dev server proxy locally.
VITE_DEV_API_TARGET=http://localhost:3001
# Optional override. Leave unset for the Vercel same-origin rewrite.
VITE_API_URL=
VITE_SITE_URL=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coast_guard
FRONTEND_URL=http://localhost:5173
PORT=3001
# Generate with openssl rand -hex 32
SERVER_SECRET=
# Values must be explicitly set to true before accepting submissions.
ENGAGEMENT_ENABLED=false
NEWSLETTER_ENABLED=false
CONSULTATION_AUTHORIZED=false
RECRUITMENT_AUTHORIZED=false
# Optional HTTPS email adapter. Use either this or SMTP.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
ENQUIRY_NOTIFY_TO=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
